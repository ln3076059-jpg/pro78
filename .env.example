# ==============================================================================
# Biến môi trường mẫu cho Hệ thống Bệnh viện & Khai phá dữ liệu kết hợp thuốc
# Sao chép tệp này thành .env hoặc nạp vào biến môi trường hệ thống
# ==============================================================================

# Cấu hình CSDL MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_mining_db
DB_USERNAME=root
DB_PASSWORD=

# Cấu hình đường dẫn dữ liệu ngoài (cho phép trỏ tới full MIMIC-III bên ngoài project)
# Ví dụ: D:/datasets/mimic-iii-clinical-database-1.4
MIMIC_DATA_DIR=demo-data
MIMIC_UPLOAD_DIR=uploads/mimic

# Cấu hình ứng dụng
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
